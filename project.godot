; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Game Hub"
config/description="Launcher em forma de mundo 3D para a biblioteca Steam."
run/main_scene="res://worlds/city/city.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

AppConfig="*res://autoload/app_config.gd"
InputDevice="*res://autoload/input_device.gd"
SteamLibrary="*res://autoload/steam_library.gd"
StoreInfo="*res://autoload/store_info.gd"
GameCategories="*res://autoload/game_categories.gd"
GameArt="*res://autoload/game_art.gd"
HubWindow="*res://autoload/hub_window.gd"
GameLauncher="*res://autoload/game_launcher.gd"
AppLibrary="*res://autoload/app_library.gd"
AppSessions="*res://autoload/app_sessions.gd"
AppLauncher="*res://autoload/app_launcher.gd"
SystemStatus="*res://autoload/system_status.gd"
FriendsService="*res://autoload/friends_service.gd"
ScreenFade="*res://ui/screen_fade.gd"
DebugMenu="*res://addons/debug_menu/debug_menu.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/debug_menu/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
display_server/driver.linuxbsd="wayland"

[gui]

theme/custom_font="res://assets/fonts/barlow/Barlow-SemiBold.ttf"

