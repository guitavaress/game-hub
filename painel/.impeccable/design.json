      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:8px 14px;border:1px solid var(--borda-forte,#2b4660);border-radius:10px;background:transparent;font-family:var(--font-body,Manrope,'Segoe UI',sans-serif);color:var(--texto,#eaf6ff);font-size:14px;font-weight:500;text-decoration:none;cursor:pointer;transition:background 150ms cubic-bezier(.16,1,.3,1),border-color 150ms cubic-bezier(.16,1,.3,1),transform 150ms cubic-bezier(.16,1,.3,1);}.ds-secondary:hover,.ds-secondary[aria-pressed=true]{background:var(--painel-2,#102640);border-color:var(--destaque-2,#24baf5)}.ds-secondary[aria-pressed=true]{color:var(--destaque,#67e8f9)}.ds-secondary:focus-visible{outline:2px solid var(--destaque,#67e8f9);outline-offset:2px;border-radius:6px}.ds-secondary:active{transform:translateY(1px) scale(.98)}.ds-secondary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Próxima subetapa",
      "kind": "button",
      "refersTo": "button-clear-dark",
      "description": "Ação de maior contraste na faixa de andamento.",
      "html": "<button class=\"ds-next\"><span><small>Próxima subetapa</small><b>Abrir o plano</b></span><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m9 5 7 7-7 7\"/></svg></button>",
      "css": ".ds-next{display:flex;justify-content:space-between;align-items:center;gap:16px;width:100%;border:1px solid var(--texto,#eaf6ff);border-radius:6px;background:var(--texto,#eaf6ff);color:var(--fundo,#07121e);padding:12px 14px;text-align:left;font-family:var(--font-body,Manrope,sans-serif);cursor:pointer;transition:transform 220ms cubic-bezier(.16,1,.3,1)}.ds-next small{display:block;font-size:10px;margin-bottom:3px}.ds-next b{display:block;font-size:12px;line-height:1.5}.ds-next:hover{transform:translateY(-2px)}.ds-next:focus-visible{outline:2px solid var(--destaque,#67e8f9);outline-offset:2px;border-radius:6px}@media(prefers-reduced-motion:reduce){.ds-next{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Campo de busca",
      "kind": "input",
      "refersTo": "field-dark",
      "description": "Busca com foco visível no recipiente.",
      "html": "<label class=\"ds-field\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 5 5\"/></svg><input type=\"search\" aria-label=\"Buscar documentos\" placeholder=\"Buscar documentos…\"/></label>",
      "css": ".ds-field{display:flex;align-items:center;gap:10px;max-width:420px;height:42px;padding:0 14px;border-radius:12px;border:1px solid var(--borda-forte,#2b4660);background:var(--painel,#0d1c2e);color:var(--fraco,#7f95ab);font:400 15.5px/1.6 var(--font-body,Manrope,sans-serif);transition:border-color 150ms cubic-bezier(.16,1,.3,1),box-shadow 150ms cubic-bezier(.16,1,.3,1)}.ds-field:focus-within{border-color:var(--destaque,#67e8f9);box-shadow:0 0 0 3px color-mix(in oklab,var(--destaque,#67e8f9) 22%,transparent)}.ds-field input{flex:1;min-width:0;border:0;background:none;color:var(--texto,#eaf6ff);font:inherit;outline:none}.ds-field input::placeholder{color:var(--fraco,#7f95ab)}@media(prefers-reduced-motion:reduce){.ds-field{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Navegação de seções",
      "kind": "nav",
      "description": "Links com marcador da seção atual.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Seções\"><a href=\"#agora\" aria-current=\"true\">Agora<span></span></a><a href=\"#rumo\">Rumo</a><a href=\"#docs\">Documentos</a></nav>",
      "css": ".ds-nav{display:flex;gap:4px;flex-wrap:wrap;font:400 12px/1.6 var(--font-body,Manrope,sans-serif)}.ds-nav a{position:relative;display:flex;align-items:center;gap:6px;padding:10px 9px;color:var(--suave,#a5b9cd);text-decoration:none;white-space:nowrap}.ds-nav a:hover,.ds-nav a[aria-current=true]{color:var(--texto,#eaf6ff)}.ds-nav a[aria-current=true] span{position:absolute;inset:auto 9px 0;height:2px;background:var(--destaque,#67e8f9)}.ds-nav a:focus-visible{outline:2px solid var(--destaque,#67e8f9);outline-offset:2px;border-radius:6px}@media(prefers-reduced-motion:reduce){.ds-nav{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip-dark",
      "description": "Rótulo informativo; variante forte sinaliza destaque.",
      "html": "<span class=\"ds-chip\">Plano</span> <span class=\"ds-chip ds-chip-strong\">Atual</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:6px;padding:2px 9px;border-radius:99px;border:1px solid var(--borda-forte,#2b4660);color:var(--suave,#a5b9cd);font:500 12px/1.6 var(--font-body,Manrope,sans-serif);white-space:nowrap}.ds-chip-strong{color:var(--destaque,#67e8f9);border-color:color-mix(in oklab,var(--destaque,#67e8f9) 45%,transparent);background:color-mix(in oklab,var(--destaque,#67e8f9) 9%,transparent)}@media(prefers-reduced-motion:reduce){.ds-chip,.ds-chip-strong{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Cartão de ideia",
      "kind": "card",
      "refersTo": "idea-dark",
      "description": "Entrada curta para uma nota; plano em repouso.",
      "html": "<button class=\"ds-idea\"><h3>Uma ideia do cofre</h3><p>Resumo da nota para escolher o que ler.</p></button>",
      "css": ".ds-idea{display:grid;gap:8px;padding:16px;border-radius:14px;border:1px solid var(--borda,#21384f);background:var(--painel,#0d1c2e);text-align:left;width:100%;box-shadow:none;font-family:var(--font-body,Manrope,'Segoe UI',sans-serif);color:var(--texto,#eaf6ff);cursor:pointer;transition:border-color 220ms cubic-bezier(.16,1,.3,1)}.ds-idea h3{margin:0;font:600 1.02rem/1.12 var(--font-display,Sora,sans-serif);letter-spacing:-.03em}.ds-idea p{margin:0;color:var(--suave,#a5b9cd);font-size:13.5px;line-height:1.6;display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}.ds-idea:hover{border-color:var(--borda-forte,#2b4660)}.ds-idea:focus-visible{outline:2px solid var(--destaque,#67e8f9);outline-offset:2px;border-radius:6px}@media(prefers-reduced-motion:reduce){.ds-idea{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Linha de documento",
      "kind": "custom",
      "description": "Lista de leitura com título, caminho e recência.",
      "html": "<button class=\"ds-doc\"><span class=\"ds-doc-title\"><b>ROADMAP</b><span>O rumo do projeto</span></span><span class=\"ds-doc-folder\">docs/</span><span class=\"ds-doc-time\">agora</span></button>",
      "css": ".ds-doc{display:grid;grid-template-columns:minmax(0,1fr) 140px 120px;gap:16px;align-items:center;padding:13px 22px;border:0;border-top:1px solid var(--borda,#21384f);width:100%;text-align:left;background:none;font-family:var(--font-body,Manrope,'Segoe UI',sans-serif);color:var(--texto,#eaf6ff);font-size:15.5px;line-height:1.6;cursor:pointer;transition:background 150ms cubic-bezier(.16,1,.3,1)}.ds-doc:hover{background:var(--painel-2,#102640)}.ds-doc:focus-visible{outline:2px solid var(--destaque,#67e8f9);outline-offset:2px;border-radius:6px}.ds-doc-title{display:grid;gap:2px;min-width:0}.ds-doc-title b{font-weight:600}.ds-doc-title span,.ds-doc-time{color:var(--fraco,#7f95ab);font-size:12.5px}.ds-doc-folder{color:var(--suave,#a5b9cd);font-size:13px}.ds-doc-time{text-align:right}@media(max-width:900px){.ds-doc{grid-template-columns:minmax(0,1fr) auto}.ds-doc-folder{display:none}}@media(prefers-reduced-motion:reduce){.ds-doc,.ds-doc-title,.ds-doc-time,.ds-doc-folder{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    },
    {
      "name": "Título de versão",
      "kind": "custom",
      "description": "Identificador editorial, selo escrito e título que abre o plano.",
      "html": "<article class=\"ds-version\"><span class=\"ds-version-id\">V1</span><span class=\"ds-version-badge\">Feita</span><h3><button>O começo</button></h3><p>Descrição curta da versão no ROADMAP.</p></article>",
      "css": ".ds-version{border-bottom:1px solid var(--borda-forte,#2b4660);padding-bottom:24px;font-family:var(--font-body,Manrope,'Segoe UI',sans-serif);color:var(--texto,#eaf6ff);}.ds-version-id{display:block;color:var(--destaque,#67e8f9);font:600 clamp(1.8rem,2.6vw,2.8rem)/1 var(--font-display,Sora,sans-serif);letter-spacing:-.04em;margin-bottom:12px}.ds-version-badge{display:inline-flex;padding:3px 7px;font-size:11px;line-height:1.5;border-radius:4px;color:var(--destaque,#67e8f9);background:color-mix(in oklab,var(--destaque,#67e8f9) 10%,var(--fundo,#07121e))}.ds-version h3{font:600 15px/1.4 var(--font-display,Sora,sans-serif);letter-spacing:-.03em;margin:10px 0}.ds-version button{padding:0;border:0;background:transparent;text-align:left;font:inherit;color:inherit;cursor:pointer}.ds-version button:hover{color:var(--destaque,#67e8f9);text-decoration:underline;text-underline-offset:4px}.ds-version button:focus-visible{outline:2px solid var(--destaque,#67e8f9);outline-offset:2px;border-radius:6px}.ds-version p{margin:0;color:var(--suave,#a5b9cd);font-size:12px;line-height:1.65}@media(prefers-reduced-motion:reduce){.ds-version,.ds-version-id,.ds-version-badge{transition-duration:.01ms!important;animation-duration:.01ms!important}}"
    }
  ],
  "narrative": {
    "northStar": "Quadro da visão do produto",
    "overview": "Um cofre para ler com calma e decidir. O chão azul-noite, as divisões finas e a tipografia editorial dão continuidade entre a visão do produto e os documentos. O nome, o símbolo e a paleta do Game Hub são compromissos de marca; o escuro é o tema padrão.\n\nO mundo visual é calmo, mas vivo: ilustrações cinematográficas azul-noite com luz âmbar ficam em pranchas, com máscaras suaves quando se integram ao fundo. O futuro perde saturação. Estados, dados e mudanças reais recebem ciano; a leitura recebe espaço. A composição evita a fileira genérica de cartões numéricos, prédios como tema central e texto longo espremido em cartão.",
    "keyCharacteristics": [
      "Azul-noite e papel, com acento ciano funcional.",
      "Sora nos títulos, Manrope na interface e Literata na leitura longa.",
      "Linhas finas e degraus de tom organizam o conteúdo.",
      "Ilustração como prancha; estados também são escritos.",
      "Movimento de entrada e atualização com redução pelo sistema e pelo botão do painel."
    ],
    "rules": [
      {
        "name": "The Estado e Dado Rule",
        "body": "Use ciano para estado, progresso, foco e mudança; mantenha as superfícies de leitura calmas.",
        "section": "colors"
      },
      {
        "name": "The Leitura com Espaço Rule",
        "body": "Texto longo ocupa a gaveta editorial; resumos de cartões servem de entrada para essa leitura.",
        "section": "typography"
      },
      {
        "name": "The Superfície Calma Rule",
        "body": "Superfícies comuns ficam planas; sombra estrutural identifica conteúdo sobreposto.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preservar nome, símbolo e paleta do Game Hub.",
      "**Do** usar tokens semânticos para manter claro e escuro coerentes.",
      "**Do** escrever o estado junto da cor e conservar números tabulares.",
      "**Do** reservar Literata e largura confortável para documentos.",
      "**Do** manter foco visível, fundo inerte em diálogos e redução de movimento pelos dois controles.",
      "**Do** guardar a proveniência das ilustrações junto aos rasters de publicação."
    ],
    "donts": [
      "**Don't** transformar texto longo em resumo espremido num cartão.",
      "**Don't** usar prédios como centro da linguagem visual do painel.",
      "**Don't** espalhar neon ou sombras de elevação em superfícies comuns.",
      "**Don't** inventar dados, datas ou progresso para preencher a composição.",
      "**Don't** retirar os estados de teclado ao reproduzir um componente."
    ]
  }
}
