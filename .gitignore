# Cache e arquivos importados da Godot 4 (a Godot recria sozinha)
.godot/

# Builds e exportações
/build/
/android/

# Arquivos temporários
*.tmp
*.translation

# Observação: a chave da Steam Web API (fase 5) fica em user://config.cfg,
# que mora em %APPDATA%\Godot\app_userdata\Game Hub\, ou seja, FORA deste repositório.

# Código nativo (Fase 14, parte 2): o que o Cargo compila fica fora do repositório
native/**/target/
native/bin/

# Python das ferramentas (tools/jev/)
__pycache__/

# Obsidian (o cofre é docs/): app.json e templates.json vão para o git;
# o layout das janelas, os plugins, os temas e as imagens coladas ficam só na máquina
docs/.obsidian/workspace*.json
docs/.obsidian/plugins/
docs/.obsidian/themes/
docs/_anexos/

# Painel do cofre (painel/): pacotes e o site compilado ficam fora do git
painel/node_modules/
painel/dist/
